<Window x:Class="ChatClient.SpectacoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiunea Spectacolelor" Height="700" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Gestiunea Spectacolelor" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,15"/> <Border Background="#F4F4F4" Padding="10" CornerRadius="5" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Administrare Spectacol" Foreground="#555" Margin="0,0,0,5"/>
                    <WrapPanel VerticalAlignment="Center">
                        <Label Content="Titlu:"/>
                        <TextBox x:Name="TextFieldTitlu" Width="150" Margin="5"/>
                        <Label Content="Data:"/>
                        <DatePicker x:Name="DatePickerData" Width="130" Margin="5"/>
                        <Label Content="Durata:"/>
                        <TextBox x:Name="TextDurata" Width="50" Margin="5" Text="2"/>
                        <Label Content="Capacitate:"/>
                        <TextBox x:Name="TextCapacitate" Width="60" Margin="5" Text="100"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label Content="Locatie:"/>
                        <TextBox x:Name="TextFieldLocatie" Width="350" Margin="5"/>
                        <Button Content="Adauga" Width="80" Margin="10,0" Click="HandleAdauga" Background="#E1F5FE"/>
                        <Button Content="Sterge" Width="80" Click="HandleSterge" Background="#FFEBEE"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Separator Height="2" Margin="0,10,0,15"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="Vanzare Bilete:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Label Content="Email Cumparator:"/>
                <TextBox x:Name="TextFieldBuyerEmail" Width="200" Margin="5"/>
                <Label Content="Locuri:"/>
                <TextBox x:Name="TextLocuriVanzare" Width="50" Margin="5" Text="1"/>
                <Button Content="Vinde" Width="100" Margin="15,0" Click="HandleVindeBilete" Background="#C8E6C9"/>
            </StackPanel>

            <DataGrid x:Name="TableSpectacole" Height="350" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      SelectionChanged="TableSpectacole_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Titlu" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding Start_date, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="130"/>
                    <DataGridTextColumn Header="Ore" Binding="{Binding Duration}" Width="50"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Capacity}" Width="60"/>
                    <DataGridTextColumn Header="Vandute" x:Name="ColVandute" Width="80"/>
                    <DataGridTextColumn Header="Disponibile" x:Name="ColDisponibile" Width="80"/>
                    <DataGridTextColumn Header="Locatie" Binding="{Binding Location}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>