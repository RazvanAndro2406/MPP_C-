<Window x:Class="ChatClient.Gui.BuyersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Cumparatori" Height="650" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Gestiune Cumparatori" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,12"/> <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Label Content="Nume:" VerticalAlignment="Center"/>
                <TextBox x:Name="TextFieldName" Width="280" Margin="10,0" VerticalContentAlignment="Center"/>
                <Button Content="Adauga" Width="75" Margin="5,0" Click="HandleAddBuyer"/>
                <Button Content="Sterge" Width="75" Margin="5,0" Click="HandleDeleteBuyer"/>
            </StackPanel>

            <DataGrid x:Name="TableBuyers" Height="200" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      SelectionChanged="TableBuyers_SelectionChanged"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                    <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Bilete cumparator selectat:" Margin="0,10,0,12" FontWeight="SemiBold"/>

            <DataGrid x:Name="TableSales" Height="200" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      SelectionChanged="TableSales_SelectionChanged"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID bilet" Binding="{Binding Id}" Width="90"/>
                    <DataGridTextColumn Header="Spectacol" Binding="{Binding SpectacleName}" Width="260"/>
                    <DataGridTextColumn Header="Cumparat la" Binding="{Binding SoldAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="220"/>
                    <DataGridTextColumn Header="Locuri" Binding="{Binding Seats}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Locuri suplimentare:" VerticalAlignment="Center"/>
                <TextBox x:Name="TextExtraSeats" Width="80" Margin="10,0" Text="1" VerticalContentAlignment="Center"/>
                <Button Content="Mareste locurile" Width="120" Click="HandleIncreaseSeats"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>