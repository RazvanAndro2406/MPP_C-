<Window x:Class="ChatClient.TicketeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiunea Biletelor (Vânzări)" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestiunea Biletelor (Vânzări)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#EEEEEE" Padding="10" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="Spectacol:"/>
                <ComboBox x:Name="ComboBoxSpectacole" Width="180" Margin="5,0"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>

                <Label Content="Email Cumpărător:"/>
                <TextBox x:Name="TextFieldBuyerEmail" Width="200" Margin="5,0" VerticalContentAlignment="Center"/>

                <Label Content="Nr. Locuri:"/>
                <TextBox x:Name="TextLocuri" Width="50" Margin="5,0" Text="1" VerticalContentAlignment="Center"/>

                <Button Content="Vinde" Width="80" Margin="10,0" Click="HandleAdauga" Background="#C8E6C9"/>
                <Button Content="Mărește locuri" Width="110" Click="HandleSterge"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="TableTickete" Grid.Row="2" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  SelectionChanged="TableTickete_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Spectacol" Binding="{Binding SpectacleName}" Width="200"/>
                <DataGridTextColumn Header="Email Cumpărător" Binding="{Binding BuyerName}" Width="200"/>
                <DataGridTextColumn Header="Nr. Locuri" Binding="{Binding Seats}" Width="80"/>
                <DataGridTextColumn Header="Vândut la data" Binding="{Binding SoldAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>