<Window x:Class="ChatClient.ArtistSpectacleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adauga Artist la Spectacol" Height="300" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Adauga Artist la Spectacol" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/> <TextBlock x:Name="LabelArtist" 
                                                      Text="Artist selectat: -" 
                                                      FontSize="12" 
                                                      Margin="0,0,0,20"/>

            <StackPanel Margin="0,0,0,20">
                <Label Content="Selectati spectacolul:"/>
                <ComboBox x:Name="ComboSpectacle" 
                          Width="300" 
                          HorizontalAlignment="Left" 
                          DisplayMemberPath="Name"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="ButtonSalveaza" 
                        Content="Salveaza" 
                        Width="80" 
                        Margin="0,0,10,0"/> <Button x:Name="ButtonAnuleaza" 
                                                    Content="Anuleaza" 
                                                    Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>