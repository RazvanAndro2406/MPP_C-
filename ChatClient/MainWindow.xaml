<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meniu Principal" Height="500" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="40">
            <TextBlock Text="Meniu Principal - Vanzare Bilete"
                       FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock x:Name="WelcomeLabel" Text="Bun venit"
                       FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Button x:Name="ButtonArtisti" Content="Gestiune Artisti"
                    Width="250" Height="40" Margin="0,10" FontSize="14"
                    Click="HandleArtisti"/>

            <Button x:Name="ButtonSpectacole" Content="Gestiune Spectacole"
                    Width="250" Height="40" Margin="0,10" FontSize="14"
                    Click="HandleSpectacole"/>

            <Button x:Name="ButtonTickete" Content="Gestiune Tickete"
                    Width="250" Height="40" Margin="0,10" FontSize="14"
                    Click="HandleTickete"/>

            <Button x:Name="ButtonCumparatori" Content="Gestiune Cumparatori"
                    Width="250" Height="40" Margin="0,10" FontSize="14"
                    Click="HandleCumparatori"/>

            <Button x:Name="ButtonLogout" Content="Deconectare"
                    Width="250" Height="40" Margin="0,30,0,0" FontSize="14"
                    Background="#FFE0E0" Click="HandleLogout"/>
        </StackPanel>
    </Grid>
</Window>